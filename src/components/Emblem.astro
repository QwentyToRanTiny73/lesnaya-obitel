---
// Знак: солнце над гребнем Красного Камня, тонкая линия.
interface Props {
  size?: number;
  class?: string;
}
const { size = 36, class: className = "" } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 40 40"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  aria-hidden="true"
  class={className}
>
  <circle cx="20" cy="20" r="19" stroke-opacity="0.55" />
  <circle cx="25" cy="15" r="4.5" />
  <path d="M5 28 13 21l3.5 2.5L21 17l3 3 3-1.5 2 2.5 6 7" stroke-linejoin="round" />
  <path d="M8 31.5h24" stroke-opacity="0.55" />
</svg>
