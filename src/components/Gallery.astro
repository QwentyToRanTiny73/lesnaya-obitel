---
// Мозаика фото с подписями. span задаёт размер плитки в сетке:
// wide — две колонки, tall — две строки, big — 2×2.
import Photo from "./Photo.astro";
import type { SitePhoto } from "../data/photos";

interface Item {
  photo: SitePhoto;
  span?: "wide" | "tall" | "big";
}
interface Props {
  items: Item[];
  class?: string;
}
const { items, class: className = "" } = Astro.props;
const spanClass = {
  wide: "col-span-2",
  tall: "row-span-2",
  big: "col-span-2 row-span-2",
};
const sizesFor = (span?: Item["span"]) =>
  span === "wide" || span === "big" ? "(min-width: 768px) 50vw, 100vw" : "(min-width: 768px) 25vw, 50vw";
---

<ul class:list={["grid auto-rows-[11rem] grid-cols-2 gap-3 md:auto-rows-[14rem] md:grid-cols-4 md:gap-4", className]}>
  {
    items.map(({ photo, span }) => (
      <li class:list={["group relative overflow-hidden", span && spanClass[span]]}>
        <Photo photo={photo} sizes={sizesFor(span)} class="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" />
        {photo.caption && (
          <p class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/75 to-transparent px-4 pt-10 pb-3 text-[0.8125rem] leading-snug text-[#f2ece1] md:text-sm">
            {photo.caption}
          </p>
        )}
      </li>
    ))
  }
</ul>
