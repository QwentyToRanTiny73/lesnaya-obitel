---
import ArtTile from "./ArtTile.astro";
import Icon from "./Icon.astro";
import { url } from "../lib/url";
import { formatPrice } from "../lib/price";

interface Props {
  domik: {
    slug: string;
    title: string;
    subtitle: string;
    capacity: number;
    count: number | null;
    highlight: string;
    prices: { offseason: number };
    pricePrefix?: string;
  };
  index: number;
}
const { domik, index } = Astro.props;
const tones = ["deep", "redstone", "moss", "claret"] as const;
const icons = ["bath", "house", "trees", "key"];
---

<article class="group flex flex-col border border-line bg-raised transition-shadow duration-500 hover:shadow-[0_24px_48px_-24px_rgb(19_36_27/0.35)]">
  <a href={url(`/domiki/${domik.slug}/`)} tabindex="-1" aria-hidden="true" class="block overflow-hidden">
    <ArtTile icon={icons[index % 4]} tone={tones[index % 4]} seed={index + 3} class="transition-transform duration-700 group-hover:scale-[1.03]" />
  </a>
  <div class="flex flex-1 flex-col p-7">
    <p class="overline">{domik.highlight}</p>
    <h3 class="h3 mt-3">
      <a href={url(`/domiki/${domik.slug}/`)} class="hover:text-accent">{domik.title}</a>
    </h3>
    <p class="mt-2 mb-6 text-sm text-muted">{domik.subtitle}</p>
    <p class="mt-5 flex items-center gap-2 text-sm text-muted">
      <Icon name="users" size={18} class="text-accent" /> до {domik.capacity} гостей
      {domik.count && domik.count > 1 && <span aria-hidden="true">·</span>}
      {domik.count && domik.count > 1 && <span>{domik.count} {domik.count >= 5 ? "домиков" : "домика"}</span>}
    </p>
    <div class="mt-auto flex items-end justify-between gap-4 border-t border-line pt-5">
      <p>
        <span class="block text-xs text-muted">{domik.pricePrefix ?? "от"} / сутки</span>
        <span class="font-display text-2xl">{formatPrice(domik.prices.offseason)}</span>
      </p>
      <a href={url(`/domiki/${domik.slug}/`)} class="link-arrow" aria-label={`Подробнее: ${domik.title}`}>
        Подробнее <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>
</article>
