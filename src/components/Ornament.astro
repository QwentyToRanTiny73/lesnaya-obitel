---
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<div class:list={["flex items-center gap-3 text-accent", className]} aria-hidden="true">
  <span class="h-px w-14 bg-current opacity-70"></span>
  <span class="size-1.5 rotate-45 border border-current"></span>
  <span class="h-px w-14 bg-current opacity-70"></span>
</div>
