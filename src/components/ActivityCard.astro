---
import Icon from "./Icon.astro";
import { url } from "../lib/url";

interface Props {
  activity: {
    id: string;
    title: string;
    description: string;
    price: string;
    priceNote?: string;
    duration?: string;
    partner?: string | null;
    icon: string;
  };
  kind: "own" | "partner";
}
const { activity, kind } = Astro.props;
---

<article class="flex flex-col border border-line bg-raised p-7 md:p-8">
  <div class="flex items-start justify-between gap-4">
    <span class="inline-flex size-14 items-center justify-center rounded-full border border-line text-accent">
      <Icon name={activity.icon} size={26} />
    </span>
    <span class="text-[0.6875rem] tracking-[0.18em] uppercase text-muted">
      {kind === "own" ? "Своё" : activity.partner ? `Партнёр · ${activity.partner}` : "Партнёр"}
    </span>
  </div>
  <h3 class="h3 mt-6">{activity.title}</h3>
  <p class="mt-3 text-[0.9375rem] leading-relaxed text-muted">{activity.description}</p>
  <div class="mt-auto pt-6">
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 border-t border-line pt-5">
      <p class="font-display text-xl">{activity.price}</p>
      {activity.duration && <p class="flex items-center gap-1.5 text-sm text-muted"><Icon name="clock" size={16} />{activity.duration}</p>}
    </div>
    {activity.priceNote && <p class="mt-1 text-sm text-muted">{activity.priceNote}</p>}
    <a href={url(`/bron/?activity=${activity.id}`)} class="link-arrow mt-3">
      Добавить к заявке <Icon name="arrow" size={16} />
    </a>
  </div>
</article>
