---
// Художественная плитка вместо фотографии. Когда появятся настоящие снимки,
// передайте src (файл из public/images/) — плитка покажет фото.
import Icon from "./Icon.astro";
import { url } from "../lib/url";

interface Props {
  icon: string;
  seed?: number;
  tone?: "deep" | "moss" | "redstone" | "claret";
  ratio?: string;
  src?: string;
  alt?: string;
  class?: string;
}
const { icon, seed = 1, tone = "deep", ratio = "4 / 3", src, alt = "", class: className = "" } = Astro.props;

const fills = {
  deep: ["#13241b", "#1d3528"],
  moss: ["#4f5d45", "#6a7a5e"],
  redstone: ["#3a221c", "#5a3328"],
  claret: ["#3d1a1e", "#5e2a2f"],
};
const [from, to] = fills[tone];
// Смещение «контуров» от seed, чтобы плитки не повторялись
const cx = 30 + ((seed * 37) % 50);
const cy = 35 + ((seed * 23) % 40);
const rings = [14, 26, 40, 56, 74, 94];
---

<div class:list={["relative overflow-hidden", className]} style={`aspect-ratio:${ratio}`}>
  {
    src ? (
      <img src={url(src)} alt={alt} loading="lazy" decoding="async" class="absolute inset-0 h-full w-full object-cover" />
    ) : (
      <>
        <svg class="absolute inset-0 h-full w-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id={`at-${seed}-${tone}`} x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color={from} />
              <stop offset="1" stop-color={to} />
            </linearGradient>
          </defs>
          <rect width="100" height="100" fill={`url(#at-${seed}-${tone})`} />
          <g fill="none" stroke="#d2b47c" stroke-width="0.25">
            {rings.map((r, i) => (
              <ellipse cx={cx} cy={cy} rx={r} ry={r * 0.78} stroke-opacity={0.42 - i * 0.06} />
            ))}
          </g>
        </svg>
        <span class="absolute inset-0 flex items-center justify-center text-[#d2b47c]">
          <Icon name={icon} size={44} strokeWidth={1} />
        </span>
      </>
    )
  }
</div>
