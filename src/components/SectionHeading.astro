---
import Ornament from "./Ornament.astro";

interface Props {
  overline?: string;
  title: string;
  lead?: string;
  align?: "left" | "center";
  as?: "h2" | "h3";
}
const { overline, title, lead, align = "left", as: Tag = "h2" } = Astro.props;
const centered = align === "center";
---

<div class:list={["max-w-3xl", centered && "mx-auto text-center"]}>
  {overline && <p class="overline mb-5">{overline}</p>}
  <Tag class="h2">{title}</Tag>
  <Ornament class:list={["mt-7", centered && "justify-center"]} />
  {lead && <p class="lead mt-7">{lead}</p>}
</div>
