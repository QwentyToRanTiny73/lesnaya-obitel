---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import breakfasts from "../data/breakfasts.json";
import { url } from "../lib/url";
---

<Base
  title="Питание и завтраки"
  description="Завтрак включён в стоимость проживания. Три формата: лёгкий, фермерский и ресторанный. Продукты с собственной фермы."
>
  <PageHero overline="Кухня" title="Завтраки" lead="Из того, что выращено здесь. Включены в стоимость проживания — формат выбираете накануне вечером." />

  <section data-tone="ivory" class="section">
    <div class="container-site">
      <div class="grid gap-6 md:grid-cols-3">
        {
          breakfasts.map((b, i) => (
            <article class="flex flex-col border border-line bg-raised p-8 md:p-10">
              <div class="flex items-center justify-between">
                <Icon name={b.icon} size={32} class="text-accent" />
                <span class="font-display text-sm text-accent">0{i + 1}</span>
              </div>
              <h2 class="h3 mt-8">{b.title}</h2>
              <p class="mt-3 leading-relaxed text-muted">{b.description}</p>
              <ul class="mt-6 grid gap-2 text-[0.9375rem]">
                {b.composition.map((c) => <li class="flex gap-3"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />{c}</li>)}
              </ul>
              <p class="mt-auto border-t border-line pt-5 text-sm text-muted">
                Дополнительный гость <span class="ml-1 font-display text-lg text-fg">{b.extraGuest}</span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-tone="champagne" class="section">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <SectionHeading
        overline="Откуда еда"
        title="С нашей фермы"
        lead="Куры, гуси, утки, цесарки и огород на территории. Яйца — утренние, мясо — своё, хлеб — домашний, варенье и компоты — с летнего урожая. Устрицы, мидии и креветки с «Причала 12» на Донузлаве — по предварительному заказу."
      />
      <div data-tone="deep" class="grain p-10 md:p-14">
        <p class="accent-italic text-3xl leading-snug">«Это не маркетинговое „фермерское“. Просто так здесь устроена жизнь.»</p>
        <a href={url("/degustacii/")} class="link-arrow mt-8">Ферма и дегустации <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>
</Base>
