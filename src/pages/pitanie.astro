---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import breakfasts from "../data/breakfasts.json";
import { url } from "../lib/url";
import Photo from "../components/Photo.astro";
import { photos } from "../data/photos";
---

<Base
  title="Питание и завтраки"
  description="Завтрак включён в стоимость проживания. Три формата: лёгкий, фермерский и ресторанный. Продукты с собственной фермы, к ужину — устрицы, мидии и вино."
>
  <PageHero
    overline="Кухня"
    title="Завтраки"
    lead="Завтрак входит в стоимость проживания. Формат выбираете накануне вечером: лёгкий, фермерский или ресторанный."
    photo={photos.grilBarRaduga}
  />

  <section data-tone="ivory" class="section">
    <div class="container-site">
      <div class="grid gap-6 md:grid-cols-3">
        {
          breakfasts.map((b, i) => (
            <article class="flex flex-col border border-line bg-raised p-8 md:p-10">
              <div class="flex items-center justify-between">
                <Icon name={b.icon} size={32} class="text-accent" />
                <span class="font-display text-sm text-accent">0{i + 1}</span>
              </div>
              <h2 class="h3 mt-8">{b.title}</h2>
              <p class="mt-3 leading-relaxed text-muted">{b.description}</p>
              <ul class="mt-6 grid gap-2 text-[0.9375rem]">
                {b.composition.map((c) => <li class="flex gap-3"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />{c}</li>)}
              </ul>
              <p class="mt-auto border-t border-line pt-5 text-sm text-muted">
                Дополнительный гость <span class="ml-1 font-display text-lg text-fg">{b.extraGuest}</span>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-tone="champagne" class="section">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
      <div>
        <SectionHeading
          overline="Откуда еда"
          title="С нашей фермы"
          lead="На территории живут куры, гуси, утки и цесарки, есть огород и сад. Яйца к завтраку утренние, мясо своё, хлеб печём сами, варенье и компоты — из летнего урожая."
        />
        <p class="mt-7 leading-relaxed text-muted">
          К ужину можно заказать устрицы, мидии и королевские креветки с Донузлава, вино Красного Камня и крафтовое пиво.
          Приготовим на гриле или отдадим свежими.
        </p>
        <a href={url("/degustacii/")} class="link-arrow mt-8">Вино и морепродукты: цены <Icon name="arrow" size={16} /></a>
      </div>
      <figure>
        <div class="relative aspect-[4/5] overflow-hidden">
          <Photo photo={photos.kuhnya} sizes="(min-width: 1024px) 560px, 100vw" class="absolute inset-0 h-full w-full object-cover" />
        </div>
        <figcaption class="mt-3 text-sm text-muted">Если хочется готовить самим — в апартаментах своя кухня.</figcaption>
      </figure>
    </div>
  </section>
</Base>
