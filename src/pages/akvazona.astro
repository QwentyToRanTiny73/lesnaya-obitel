---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import prices from "../data/prices.json";
import { phoneUrl, site } from "../data/site";
import { url } from "../lib/url";
import { formatPrice } from "../lib/price";

const features = [
  { icon: "flame", title: "Финская баня", text: "Сухой жар, берёзовые веники, тишина леса за окном. Круглый год." },
  { icon: "waves", title: "Бассейн с подогревом", text: "Под открытым небом. Тёплая вода даже в декабре." },
  { icon: "sofa", title: "Комната отдыха", text: "На шестерых: диваны, чай, тишина между заходами." },
];

const range = (min: number, max: number) =>
  min === max ? formatPrice(min) : `${formatPrice(min).replace(/ ₽$/, "")}–${formatPrice(max)}`;
---

<Base
  title="Аквазона"
  description="Финская баня, бассейн с подогревом и комната отдыха на 6 человек. Круглый год. Дневной и вечерний тарифы, банный ритуал."
>
  <PageHero
    overline="Баня и бассейн"
    title="Аквазона"
    lead="Бронируется отдельно, по часам. Работает круглый год, гостям базы — приоритет."
  />

  <section data-tone="ivory" class="section">
    <div class="container-site">
      <ul class="grid gap-px border border-line bg-line md:grid-cols-3">
        {
          features.map((f) => (
            <li class="bg-surface p-10 md:p-12">
              <Icon name={f.icon} size={34} class="text-accent" />
              <h2 class="h3 mt-8">{f.title}</h2>
              <p class="mt-3 leading-relaxed text-muted">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section data-tone="champagne" class="section">
    <div class="container-site grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <SectionHeading overline="Стоимость" title="Тарифы" lead="Минимальный заказ — 3 часа. Бронирование через администратора." />
      <div class="overflow-x-auto">
        <table class="price-table min-w-[28rem]">
          <caption class="sr-only">Тарифы аквазоны</caption>
          <thead><tr><th scope="col">Тариф</th><th scope="col">Время</th><th scope="col" class="num">Стоимость</th></tr></thead>
          <tbody>
            {
              prices.aquazone.map((t) => (
                <tr>
                  <td class="font-display text-lg">{t.tariff}</td>
                  <td class="text-muted">{t.time}</td>
                  <td class="num">
                    {range(t.priceMin, t.priceMax)}
                    <span class="block font-sans text-xs text-muted">{t.unit.replace("₽", "").trim()}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section data-tone="deep" class="section grain">
    <div class="container-site max-w-3xl text-center">
      <p class="accent-italic text-3xl md:text-4xl">Зимой в тёплом бассейне под снегом — отдельное воспоминание.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={phoneUrl} class="btn btn-gold"><Icon name="phone" size={16} />{site.phone.display}</a>
        <a href={url("/bron/?activity=banya")} class="btn btn-outline">Добавить к проживанию</a>
      </div>
    </div>
  </section>
</Base>
