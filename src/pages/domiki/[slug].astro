---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ArtTile from "../../components/ArtTile.astro";
import DomikCard from "../../components/DomikCard.astro";
import Icon from "../../components/Icon.astro";
import Ornament from "../../components/Ornament.astro";
import domiki from "../../data/domiki.json";
import { site } from "../../data/site";
import { url } from "../../lib/url";
import { formatPrice, seasonLabels, seasonMonths, type Season } from "../../lib/price";

export function getStaticPaths() {
  return domiki.map((d, index) => ({ params: { slug: d.slug }, props: { domik: d, index } }));
}

const { domik: d, index } = Astro.props;
const seasons: Season[] = ["offseason", "season", "peak"];
const tones = ["deep", "redstone", "moss", "claret"] as const;
const icons = ["bath", "house", "trees", "key"];
const others = domiki.map((o, i) => ({ o, i })).filter(({ o }) => o.id !== d.id);
---

<Base title={d.title} description={d.description}>
  <PageHero overline={d.highlight} title={d.title} lead={d.subtitle} />

  <section data-tone="ivory" class="section">
    <div class="container-site">
      <nav aria-label="Хлебные крошки" class="mb-12 text-sm text-muted">
        <a href={url("/")} class="hover:text-fg">Главная</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <a href={url("/domiki/")} class="hover:text-fg">Домики</a>
        <span aria-hidden="true" class="mx-2">/</span>
        <span aria-current="page" class="text-fg">{d.title}</span>
      </nav>

      <div class="grid gap-14 lg:grid-cols-[1.25fr_1fr] lg:gap-20">
        <div>
          <ArtTile icon={icons[index]} tone={tones[index]} seed={index + 3} ratio="16 / 10" />
          <p class="mt-10 text-lg leading-relaxed">{d.description}</p>
          <h2 class="h3 mt-12">Удобства</h2>
          <ul class="mt-6 grid gap-px border border-line bg-line sm:grid-cols-2">
            {d.features.map((f) => (
              <li class="flex items-center gap-4 bg-surface px-5 py-4"><Icon name={f.icon} size={22} class="text-accent" />{f.label}</li>
            ))}
          </ul>
        </div>

        <aside data-tone="champagne" class="h-fit p-8 md:p-10 lg:sticky lg:top-28" aria-label="Стоимость и бронирование">
          <p class="overline">Стоимость за сутки</p>
          <table class="price-table mt-6">
            <caption class="sr-only">Цены по сезонам</caption>
            <tbody>
              {seasons.filter((s) => d.prices[s] !== null).map((s) => (
                <tr>
                  <th scope="row">
                    {seasonLabels[s]}
                    <span class="sub">{seasonMonths[s]}</span>
                  </th>
                  <td class="num text-2xl">{d.pricePrefix ? `${d.pricePrefix} ` : ""}{formatPrice(d.prices[s]!)}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <ul class="mt-6 grid gap-2 text-sm text-muted">
            <li class="flex gap-2"><Icon name="users" size={18} class="shrink-0 text-accent" />до {d.capacity} гостей</li>
            <li class="flex gap-2"><Icon name="moon" size={18} class="shrink-0 text-accent" />от {d.minNights ?? site.minNights} ночей</li>
            <li class="flex gap-2"><Icon name="clock" size={18} class="shrink-0 text-accent" />заезд с {site.checkIn}, выезд до {site.checkOut}</li>
          </ul>
          <a href={url(`/bron/?type=${d.id}`)} class="btn btn-dark mt-8 w-full">Забронировать</a>
        </aside>
      </div>
    </div>
  </section>

  <section data-tone="champagne" class="section">
    <div class="container-site">
      <h2 class="h2">Другие варианты</h2>
      <Ornament class="mt-6" />
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        {others.map(({ o, i }) => <DomikCard domik={o} index={i} />)}
      </div>
    </div>
  </section>
</Base>
