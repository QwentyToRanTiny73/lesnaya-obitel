---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Icon from "../components/Icon.astro";
import wines from "../data/wines.json";
import prices from "../data/prices.json";
import { site, telegramUrl } from "../data/site";
import { url } from "../lib/url";
import { formatPrice } from "../lib/price";

const typeLabel: Record<string, string> = { red: "Красное", rose: "Розовое", white: "Белое" };
const typeDot: Record<string, string> = { red: "bg-[#a4473f]", rose: "bg-rose", white: "bg-gold-light" };

const range = (min: number, max: number | null) =>
  !max || min === max ? formatPrice(min) : `${formatPrice(min).replace(/ ₽$/, "")}–${formatPrice(max)}`;

const farm = [
  { icon: "egg", title: "Птичий двор", text: "Куры, гуси, утки, цесарки. Свежие яйца каждое утро." },
  { icon: "leaf", title: "Мясо и заготовки", text: "Своя свинина и птица, домашние заготовки, компоты." },
  { icon: "shell", title: "«Причал 12»", text: "Устрицы, мидии и креветки с нашей фермы на Донузлаве — по заказу." },
  { icon: "wheat", title: "Сувениры", text: "Фермерские чипсы из мяса — с собой, от 500 ₽ за упаковку." },
];
---

<Base
  title="Дегустации и ферма"
  description="Вина собственного производства у Красного Камня: Каберне-Сира, Саперави, Розе, Мускат, Кокур. Устрицы, мидии и креветки с «Причала 12», устричное пиво. Ферма."
>
  <PageHero
    overline="Винодельня и ферма"
    title="Дегустации"
    lead="Вино с нашей лозы — от виноградника до бокала у Красного Камня. Морепродукты с Донузлава. Устричное пиво."
  />

  <section data-tone="deep" class="section grain">
    <div class="container-site">
      <SectionHeading
        overline="Наши вина"
        title="От лозы до бокала"
        lead="Виноградники у скалы Красный Камень. Лоза, давильня, бочка, бутылка — всё здесь, на нашей территории."
      />
      <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          wines.map((w) => (
            <article class="flex flex-col border border-line bg-raised p-8">
              <p class="flex items-center gap-2 text-[0.6875rem] tracking-[0.18em] uppercase text-muted">
                <span class:list={["size-2 rounded-full", typeDot[w.type]]} aria-hidden="true" />
                {typeLabel[w.type]}
              </p>
              <h3 class="accent-italic mt-5 text-[2.25rem] leading-none">{w.name}</h3>
              <p class="mt-3 text-accent">{w.profile}</p>
              <p class="mt-5 leading-relaxed text-muted">{w.description}</p>
              <dl class="mt-auto grid gap-1 border-t border-line pt-5 text-sm">
                <div class="flex justify-between gap-4"><dt class="shrink-0 text-muted">К столу</dt><dd class="text-right">{w.pairing}</dd></div>
                <div class="flex justify-between gap-4"><dt class="shrink-0 text-muted">Подача</dt><dd>{w.temperature}</dd></div>
              </dl>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section data-tone="ivory" class="section">
    <div class="container-site grid gap-14 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
      <SectionHeading
        overline="Форматы"
        title="Что попробовать"
        lead="Дегустации проходят по записи. Укажите формат в заявке на бронирование или напишите нам."
      />
      <div class="overflow-x-auto">
        <table class="price-table min-w-[34rem]">
          <caption class="sr-only">Форматы дегустаций и цены</caption>
          <thead>
            <tr><th scope="col">Формат</th><th scope="col">Состав</th><th scope="col" class="num">Цена</th></tr>
          </thead>
          <tbody>
            {
              prices.degustations.map((d) => (
                <tr>
                  <td class="font-display text-lg">{d.format}</td>
                  <td class="text-sm text-muted">{d.composition}</td>
                  <td class="num">
                    {d.priceMax === null ? "от " : ""}
                    {range(d.priceMin, d.priceMax)}
                    <span class="block font-sans text-xs text-muted">{d.unit.replace("₽", "").trim()}</span>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section data-tone="champagne" class="section">
    <div class="container-site">
      <SectionHeading overline="Ферма" title="Как еда попадает на стол" />
      <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          farm.map((f) => (
            <li class="border-t border-accent pt-6">
              <Icon name={f.icon} size={28} class="text-accent" />
              <h3 class="mt-5 font-display text-xl">{f.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{f.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section data-tone="ivory" class="section">
    <div class="container-site max-w-3xl text-center">
      <h2 class="h2">Записаться на дегустацию</h2>
      <p class="lead mx-auto mt-6">Напишите удобный день — подберём формат под вашу компанию.</p>
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={url("/bron/?activity=degustacia")} class="btn btn-dark">Добавить к брони</a>
        <a href={telegramUrl} target="_blank" rel="noopener" class="btn btn-outline"><Icon name="send" size={16} />Telegram</a>
      </div>
      <p class="mt-10 text-xs leading-relaxed text-muted">
        18+. Чрезмерное употребление алкоголя вредит вашему здоровью. Дегустации проводятся только для совершеннолетних гостей.
      </p>
    </div>
  </section>
</Base>
