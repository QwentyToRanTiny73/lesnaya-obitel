---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { url } from "../lib/url";
---

<Base title="Страница не найдена" noindex>
  <PageHero overline="404" title="Здесь только лес" lead="Такой страницы нет — возможно, ссылка устарела.">
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={url("/")} class="btn btn-gold">На главную</a>
      <a href={url("/domiki/")} class="btn btn-outline">Домики</a>
    </div>
  </PageHero>
</Base>
