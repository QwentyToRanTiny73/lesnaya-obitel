---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import BookingBar from "../components/BookingBar.astro";
import SectionHeading from "../components/SectionHeading.astro";
import DomikCard from "../components/DomikCard.astro";
import ActivityCard from "../components/ActivityCard.astro";
import Ornament from "../components/Ornament.astro";
import Icon from "../components/Icon.astro";
import Gallery from "../components/Gallery.astro";
import { photos } from "../data/photos";
import domiki from "../data/domiki.json";
import wines from "../data/wines.json";
import activities from "../data/activities.json";
import { site, phoneUrl, telegramUrl, fullAddress } from "../data/site";
import { url } from "../lib/url";
import { formatPrice } from "../lib/price";
import { trips } from "../data/trips";
import Reviews from "../components/Reviews.astro";

const principles = [
  { icon: "key", title: "Закрытая территория", text: "Въезд через шлагбаум, на территории только гости базы." },
  { icon: "moon", title: "От двух ночей", text: "Хватит времени и выспаться, и съездить в горы или к морю." },
  { icon: "grape", title: "Своё вино и ферма", text: "Вино с виноградников Красного Камня, яйца и мясо с нашей фермы." },
  { icon: "trees", title: "8 гектаров леса", text: "Тропы, родник, пруд и поляны — гулять можно, не выходя за ворота." },
];

const stats = [
  { value: "8 га", label: "леса у подножия скалы" },
  { value: "14", label: "домиков и апартаменты" },
  { value: "5", label: "вин собственного урожая" },
  { value: "365", label: "дней баня и бассейн" },
];

const wineDot: Record<string, string> = { red: "bg-[#a4473f]", rose: "bg-rose", white: "bg-gold-light" };
const minBottle = Math.min(...wines.flatMap((w) => (w.priceBottle ? [w.priceBottle] : [])));

const farm = [
  { icon: "egg", text: "Свежие яйца каждое утро" },
  { icon: "wheat", text: "Домашний хлеб и заготовки" },
  { icon: "leaf", text: "Птица и мясо с фермы" },
  { icon: "shell", text: "Устрицы, мидии и креветки с Донузлава" },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "LodgingBusiness",
  name: site.name,
  description: site.description,
  url: new URL(import.meta.env.BASE_URL, Astro.site).href,
  telephone: site.phone.raw,
  priceRange: "11 000–30 000 ₽ за сутки",
  address: {
    "@type": "PostalAddress",
    streetAddress: site.address.street,
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: "RU",
  },
  checkinTime: site.checkIn,
  checkoutTime: site.checkOut,
  amenityFeature: ["Завтрак включён", "Wi-Fi", "Финская баня", "Бассейн с подогревом", "Дегустации вина", "Футбольное поле"].map((name) => ({
    "@type": "LocationFeatureSpecification",
    name,
    value: true,
  })),
};
---

<Base jsonLd={jsonLd}>
  <PageHero size="full" overline="Краснокаменка · Южный берег Крыма" title="Лесная Обитель" lead={site.tagline} photo={photos.ayuDagPanorama}>
    <div class="mt-10 flex flex-wrap gap-4">
      <a href={url("/bron/")} class="btn btn-gold">Забронировать</a>
      <a href={url("/domiki/")} class="btn btn-outline">Домики и цены</a>
    </div>
  </PageHero>

  <!-- Подбор дат: заходит на обложку -->
  <section data-tone="ivory" class="relative">
    <div class="container-site relative -mt-14 md:-mt-20">
      <BookingBar />
      <p class="mt-4 text-center text-sm text-muted">
        От {site.minNights} ночей · заезд с {site.checkIn} · выезд до {site.checkOut} · завтрак включён
      </p>
    </div>
  </section>

  <!-- Манифест -->
  <section data-tone="ivory" class="section">
    <div class="container-site grid gap-16 lg:grid-cols-[1fr_1fr] lg:gap-24">
      <SectionHeading
        overline="О месте"
        title="Дом в лесу над Гурзуфом"
        lead="Восемь гектаров леса у скалы Красный Камень, до моря — пятнадцать минут на машине. На территории домики среди деревьев, сад и огород, футбольное поле, площадка для волейбола и баскетбола, гриль-бар. С верхней поляны видно Аю-Даг и море. К нам приезжают семьями и компаниями: выспаться, погулять по горам и поесть то, что выросло рядом."
      />
      <ul class="grid gap-px self-center border border-line bg-line sm:grid-cols-2">
        {
          principles.map((p) => (
            <li class="bg-surface p-7">
              <Icon name={p.icon} size={28} class="text-accent" />
              <h3 class="mt-5 font-display text-xl">{p.title}</h3>
              <p class="mt-2 text-[0.9375rem] leading-relaxed text-muted">{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Цифры -->
  <section data-tone="ivory" class="pb-8">
    <div class="container-site">
      <dl class="grid grid-cols-2 border-y border-line md:grid-cols-4">
        {
          stats.map((s, i) => (
            <div
              class:list={[
                "border-line px-4 py-10 text-center",
                i % 2 === 1 && "border-l",
                i >= 2 && "border-t md:border-t-0",
                i === 2 && "md:border-l",
              ]}
            >
              <dt class="sr-only">{s.label}</dt>
              <dd class="font-display text-5xl md:text-6xl">{s.value}</dd>
              <dd class="mt-3 text-sm text-muted">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Размещение -->
  <section data-tone="champagne" class="section">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading overline="Размещение" title="Домики и апартаменты" lead="Четырнадцать домиков и апартаменты. Завтрак включён во все тарифы." />
        <a href={url("/domiki/")} class="link-arrow">Все варианты <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {domiki.map((d, i) => <DomikCard domik={d} index={i} />)}
      </div>
    </div>
  </section>

  <!-- Территория -->
  <section data-tone="ivory" class="section">
    <div class="container-site">
      <SectionHeading
        overline="Территория"
        title="Что вас ждёт на месте"
        lead="Лес, спортплощадки, гриль-бар и виды на Аю-Даг. Всё это в пределах базы."
      />
      <Gallery
        class="mt-14"
        items={[
          { photo: photos.ayuDagTuman, span: "big" },
          { photo: photos.futbolnoePole, span: "tall" },
          { photo: photos.ploshchadka, span: "tall" },
          { photo: photos.grilBarRaduga, span: "wide" },
          { photo: photos.territoriyaSverhu, span: "wide" },
        ]}
      />
    </div>
  </section>

  <!-- Вино -->
  <section data-tone="deep" class="section grain">
    <div class="container-site grid gap-16 lg:grid-cols-[0.9fr_1.1fr] lg:gap-24">
      <div>
        <SectionHeading
          overline="Вино"
          title="Вино Красного Камня"
          lead="Урожай 2025 года: Кокур, Мускат и Розе — сухие вина малой серии, виноград собран вручную. Их можно попробовать на дегустации или взять бутылку к ужину."
        />
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href={url("/degustacii/")} class="btn btn-gold">Вино и устрицы</a>
          <span class="text-sm text-muted">бутылка от {formatPrice(minBottle)}</span>
        </div>
      </div>
      <ol class="border-t border-line">
        {
          wines.map((w, i) => (
            <li class="grid grid-cols-[2.5rem_1fr] gap-x-4 border-b border-line py-6">
              <span class="pt-1 font-display text-sm text-accent">0{i + 1}</span>
              <div>
                <p class="flex items-center gap-3">
                  <span class:list={["size-2 rounded-full", wineDot[w.type]]} aria-hidden="true" />
                  <span class="accent-italic text-[1.75rem] leading-none">{w.name}</span>
                </p>
                <p class="mt-2 text-[0.9375rem] text-muted">{w.style}{w.vintage ? `, ${w.vintage}` : ""} · {w.profile}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Впечатления -->
  <section data-tone="ivory" class="section">
    <div class="container-site">
      <div class="flex flex-wrap items-end justify-between gap-8">
        <SectionHeading
          overline="Чем заняться"
          title="Горы, море и прогулки"
          lead="Подняться на Красный Камень, проехать на электробайке до яйлы, выйти на рыбалку на рассвете. Любое занятие можно отметить в заявке на бронирование."
        />
        <a href={url("/aktivnosti/")} class="link-arrow">Все активности <Icon name="arrow" size={16} /></a>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {activities.own.map((a) => <ActivityCard activity={a} kind="own" />)}
      </div>
    </div>
  </section>

  <!-- Готовые сценарии -->
  <section data-tone="champagne" class="section">
    <div class="container-site">
      <SectionHeading
        overline="Идеи для поездки"
        title="Готовые сценарии"
        lead="Выберите сценарий — домик и занятия уже будут отмечены в заявке. Стоимость проживания посчитается по вашим датам."
      />
      <div class="mt-14 grid gap-6 lg:grid-cols-3">
        {
          trips.map((t) => (
            <article class="flex flex-col border border-line bg-raised p-8">
              <p class="overline">{t.who} · {t.nights} ночи</p>
              <h3 class="h3 mt-4">{t.title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{t.text}</p>
              <ul class="mt-6 grid gap-2 text-[0.9375rem]">
                <li class="flex gap-3"><Icon name="house" size={18} class="mt-0.5 shrink-0 text-accent" />{t.stayTitle}</li>
                {t.activityLabels.map((a) => <li class="flex gap-3"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-accent" />{a}</li>)}
              </ul>
              <div class="mt-auto pt-8">
                <p class="border-t border-line pt-5 text-sm text-muted">
                  Проживание от <span class="font-display text-xl text-fg">{formatPrice(t.stayFrom)}</span> за {t.nights} ночи
                  <span class="block">≈ {formatPrice(t.perPersonNight)} с человека в сутки при {t.guests} гостях, завтрак включён</span>
                </p>
                <a href={url(`/bron/?${t.bookingQuery}`)} class="btn btn-dark mt-6 w-full">Выбрать даты</a>
              </div>
            </article>
          ))
        }
      </div>
      <p class="mt-10 text-sm text-muted">
        Едете большой группой? <a href={url("/gruppam/")} class="text-accent underline underline-offset-4">Аренда всей базы до 80 гостей</a>.
      </p>
    </div>
  </section>

  <!-- Ферма и аквазона -->
  <section data-tone="champagne" class="section">
    <div class="container-site grid gap-16 lg:grid-cols-2 lg:gap-24">
      <div>
        <SectionHeading
          overline="Ферма"
          title="Еда с нашей фермы"
          lead="Куры, гуси, утки, цесарки, свиньи и огород. Утром к завтраку — свежие яйца, мясо готовим своё. Устрицы, мидии и креветки привозим с Донузлава под заказ."
        />
        <ul class="mt-10 grid gap-4 sm:grid-cols-2">
          {farm.map((f) => <li class="flex items-start gap-4"><Icon name={f.icon} size={24} class="mt-0.5 shrink-0 text-accent" /><span>{f.text}</span></li>)}
        </ul>
        <a href={url("/pitanie/")} class="link-arrow mt-8">Завтраки <Icon name="arrow" size={16} /></a>
      </div>
      <div data-tone="deep" class="grain flex flex-col justify-between p-10 md:p-14">
        <div>
          <p class="overline">Аквазона</p>
          <h3 class="h2 mt-5">Баня и бассейн круглый год</h3>
          <p class="lead mt-6">Финская баня, бассейн с подогревом под открытым небом и комната отдыха на шестерых. Работает круглый год, зимой тоже.</p>
        </div>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href={url("/akvazona/")} class="btn btn-outline">Тарифы</a>
          <span class="text-sm text-muted">от 3 000 ₽/час</span>
        </div>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- Финал -->
  <section data-tone="ivory" class="section">
    <div class="container-site max-w-3xl text-center">
      <p class="accent-italic text-3xl text-muted md:text-4xl">Заезд с {site.checkIn}, от двух ночей</p>
      <h2 class="h2 mt-4">Ждём в гости</h2>
      <Ornament class="mt-8 justify-center" />
      <div class="mt-10 flex flex-wrap justify-center gap-4">
        <a href={url("/bron/")} class="btn btn-dark">Забронировать</a>
        <a href={telegramUrl} target="_blank" rel="noopener" class="btn btn-outline"><Icon name="send" size={16} />Написать в Telegram</a>
      </div>
      <p class="mt-8 text-sm text-muted">
        <a href={phoneUrl} class="underline-offset-4 hover:underline">{site.phone.display}</a> · {fullAddress}
      </p>
    </div>
  </section>
</Base>
